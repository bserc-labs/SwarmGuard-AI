# Backend-only environment. For Docker, use the root .env.example instead —
# compose supplies these values to the container.
#
# Generate each secret independently:
#   openssl rand -hex 32

# PostgreSQL/TimescaleDB is required. SQLite raises at import time.
DATABASE_URL=postgresql://swarmguard:CHANGE_ME@localhost:5432/swarmguard

# Required, 32+ chars, must be unique. Startup fails on known placeholders.
SECRET_KEY=
DRONE_API_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

REDIS_URL=redis://localhost:6379

# Separate database for the test suite. Required by pytest — it must never
# point at the database you develop against.
TEST_DATABASE_URL=postgresql://swarmguard:CHANGE_ME@localhost:5432/swarmguard_test
