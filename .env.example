# SwarmGuard AI — settings. Copy to .env before the first `docker compose up`.
# .env is gitignored. Never commit real values.
#
# SECRETS DO NOT GO IN THIS FILE when you run under Docker. They are files:
#
#   scripts/init-secrets.sh        # creates ./secrets/{secret_key,drone_api_key,
#                                  #   postgres_password,admin_password}
#
# As environment variables they were printed by `docker inspect` to anyone with
# Docker access. Compose passes them to the containers as *empty* variables, so
# even if you leave them below they cannot reach a container -- but the script
# does read them from here once, so an existing deployment keeps the database
# password its volume was initialised with.
#
# Running the backend natively (no Docker)? Then there is no /run/secrets, and
# the variables below are how it is configured. Generate each independently:
#   openssl rand -hex 32

# --- Database -----------------------------------------------------------
POSTGRES_USER=swarmguard
POSTGRES_DB=swarmguard
# Native runs only; under Docker this is ./secrets/postgres_password.
POSTGRES_PASSWORD=

# Native runs only. Inside Docker, compose builds the URL from POSTGRES_USER /
# POSTGRES_DB and the `postgres` hostname, and the password is joined in from
# its secret file (or from DATABASE_PASSWORD, for a URL that carries none).
# SQLite is not supported — the app requires PostgreSQL/TimescaleDB.
DATABASE_URL=postgresql://swarmguard:CHANGE_ME@localhost:5432/swarmguard

# Connection budget. Requests inside the API at once, the threads behind
# asyncio.to_thread, and a reserve must fit in the pool, or the API refuses to
# start: a request holds its connection across thread hops, and demand beyond
# the pool deadlocks on it. Beyond HTTP_MAX_IN_FLIGHT, requests wait at the
# door and get 503 + Retry-After after HTTP_ADMISSION_WAIT_S.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40
# HTTP_MAX_IN_FLIGHT=40
# HTTP_ADMISSION_WAIT_S=5
# BACKGROUND_THREADS=12
# DB_POOL_RESERVE=4
# Worker processes. One serves about 200 telemetry packets a second; two hold
# 400/s. Each opens its own pool, so workers x (pool + overflow) must fit
# PostgreSQL's max_connections -- start-up refuses otherwise. Above one worker
# the entrypoint turns on Prometheus multiprocess mode so a scrape reports the
# whole application, and background passes are claimed in Redis so they run once
# per interval rather than once per worker.
# UVICORN_WORKERS=1
# DB_SERVER_MAX_CONNECTIONS=100

# --- Secrets (native runs only; 32+ chars, must be unique) ---------------
# Startup fails if these are missing, too short, or a known placeholder.
# Under Docker: ./secrets/secret_key and ./secrets/drone_api_key.
SECRET_KEY=
DRONE_API_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Cache / pub-sub ----------------------------------------------------
# Used when running the backend outside Docker. Inside Docker, compose
# overrides this with the `redis` service hostname.
REDIS_URL=redis://localhost:6379

# --- First-run provisioning (optional) ----------------------------------
# A username and a password create the default organization and its admin, once,
# from the migrate job. Password: at least 12 characters. Under Docker put it in
# ./secrets/admin_password (init-secrets.sh copies it from here the first time);
# only the migrate job can read that file, the API never sees it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- MAVLink ingest -----------------------------------------------------
# Disabled by default. With no MAVLink source configured the receiver would
# reconnect-loop against 127.0.0.1:14550 forever.
MAVLINK_ENABLED=false
# Required when MAVLINK_ENABLED=true: it owns the telemetry, the drones and any
# incident detection raises from them. Start-up refuses without it, and a packet
# that somehow arrives without one is dropped rather than written to a tenant
# that cannot see it.
MAVLINK_ORGANIZATION_ID=
MAVLINK_HOST=127.0.0.1
MAVLINK_PORT=14550
MAVLINK_PROTOCOL=udp

# --- Tier 1: kinematic guard ---------------------------------------------
# Deterministic physics checks. Limits describe the airframe's envelope with
# margin; defaults suit a fast multirotor. Raise for fixed-wing.
GUARD_ENABLED=true
GUARD_MAX_SPEED_MPS=60
GUARD_MAX_CLIMB_MPS=25
GUARD_GPS_SPEED_ERROR_MPS=25
GUARD_MIN_SATELLITES=6
# Rates are computed over the device's own sample clock (sample_time_ms,
# MAVLink time_boot_ms) when a packet carries one, and over server arrival
# time otherwise. This bounds how far the device clock may exceed arrival
# spacing before it is disbelieved for that pair.
GUARD_DEVICE_CLOCK_MAX_LEAD_S=10
# A packet delivered late is rated against its nearest neighbour on the device
# clock. This bounds how far behind the rest of the window it may be before a
# backwards clock is taken for a reboot or wrap instead.
GUARD_DEVICE_CLOCK_MAX_REORDER_S=10
# Arrival time stands in for the device clock only when the packets arrived far
# enough apart to mean something. The reason to trust it is a reset, and a reset
# takes time: closer together than this, the clock stepped back because a packet
# was delivered late, and the guard declines to rate rather than divide by it.
GUARD_MIN_RESET_GAP_S=1

# --- Tier 2: ML anomaly layer --------------------------------------------
# OFF because it is measured to not generalize: F1 0.086 with a 0.862 false
# positive rate under leave-one-flight-out validation. The authoritative
# numbers are backend/models_ml/v2/evaluation.json; see also the README.
AI_INCIDENTS_ENABLED=false

# --- Model ---------------------------------------------------------------
# Active version in backend/models_ml/. v2 is the RandomForest trained on real
# PX4 flights; v1 is the legacy IsolationForest trained on synthetic data.
# The feature list is read from the model's own metadata, so switching this
# does not require editing FEATURE_LIST.
MODEL_VERSION=v2

# --- Device credentials ----------------------------------------------------------
# Per-drone ingest keys are issued with POST /drones/{id}/credentials. The shared
# DRONE_API_KEY is also accepted while this is true; set it false once no drone
# uses it (docs/OPERATIONS.md, "Device credentials").
# DEVICE_SHARED_KEY_ENABLED=true

# --- Audit retention -----------------------------------------------------------
# audit_logs is append-only; rows older than this are deleted once a day. 0
# keeps everything -- set that where regulation, not disk, decides retention.
# AUDIT_RETENTION_DAYS=365

# --- Error tracking ----------------------------------------------------------
# A Sentry-compatible DSN turns on error tracking; under Docker it is the secret
# file ./secrets/sentry_dsn (empty = off). These two tag every event and metric.
# SWARMGUARD_ENV=development
# SWARMGUARD_RELEASE=

# --- Metrics -----------------------------------------------------------------
# /metrics (Prometheus) is reachable only inside the compose network and on the
# host's loopback port. Set a token to require it as a bearer as well.
# METRICS_TOKEN=

# --- Readiness ---------------------------------------------------------------
# /ready answers 503 when postgres or Redis is down (docs/OPERATIONS.md). With
# several API replicas behind a load balancer, set this false so a Redis
# outage degrades rather than removes every replica at once.
# READINESS_REQUIRES_REDIS=true
# READINESS_TIMEOUT_S=3

# --- Migrations ------------------------------------------------------------
# Under compose a one-shot `migrate` job applies migrations and the API waits
# for it; nothing to set. The API refuses to start against a schema that is
# behind the build. Turn the check off only while repairing a database by hand.
# REQUIRE_SCHEMA_AT_HEAD=true
#
# Running the image on its own, with no job to migrate first? Let it migrate
# before it serves. An advisory lock makes this safe even with several replicas,
# but each then pays for an alembic run on every start.
# RUN_MIGRATIONS_ON_START=false

# --- TLS (optional) ----------------------------------------------------------
# nginx serves HTTPS on 443 and only redirects on 80. Put tls.crt (full chain)
# and tls.key in this directory; with it empty a self-signed certificate is
# generated at start, which is fine on a laptop and never on a server.
# scripts/make-dev-cert.sh writes a stable self-signed pair for local use.
# SWARMGUARD_CERTS_DIR=./certs
# Subject of that self-signed fallback only.
# SWARMGUARD_HOSTNAME=localhost
# Let's Encrypt HTTP-01 webroot (certbot --webroot -w ./acme).
# SWARMGUARD_ACME_DIR=./acme

# Browser origins allowed to call the API with credentials, comma-separated.
# The deployed frontend is same-origin through nginx and needs no entry; this is
# for the Vite dev server. "*" is refused.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost

# --- Deploying published images (server only) --------------------------------------
# scripts/deploy.sh sha-<commit> runs the images CI pushed to GHCR, via
# docker-compose.prod.yml. Nothing to set for local development.
# SWARMGUARD_IMAGE_PREFIX=ghcr.io/bserc-labs
# SWARMGUARD_SMOKE_TIMEOUT_S=120
# Only with a self-signed certificate: let the smoke test skip verification.
# SWARMGUARD_SMOKE_INSECURE=1

# --- Backups (optional) ----------------------------------------------------------
# A compressed pg_dump every BACKUP_INTERVAL_S seconds (this is the RPO), kept
# BACKUP_RETAIN_DAYS. Dumps go to the `backups` volume unless
# SWARMGUARD_BACKUP_DIR names a host directory -- one that is copied off the
# host, or the backup dies with the disk.
# BACKUP_INTERVAL_S=21600
# BACKUP_RETAIN_DAYS=14
# SWARMGUARD_BACKUP_DIR=./backups

# --- Container limits (optional) -----------------------------------------------
# Defaults suit a small server. The postgres values are one decision: keep
# shared_buffers at 25% and effective_cache_size at 75% of its memory limit.
# BACKEND_MEMORY_LIMIT=1g
# BACKEND_CPUS=2.0
# POSTGRES_MEMORY_LIMIT=2g
# POSTGRES_SHARED_BUFFERS=512MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
# REDIS_MEMORY_LIMIT=256m
# REDIS_MAXMEMORY=192mb
# FRONTEND_MEMORY_LIMIT=128m

# --- Where the secret files live (optional) --------------------------------
# Default ./secrets, which is gitignored. Point it outside the checkout -- a
# tmpfs, or wherever your secret manager's agent writes -- for anything real.
# SWARMGUARD_SECRETS_DIR=./secrets

# --- Compose network (optional) ------------------------------------------
# Everything in this file is passed to the backend container. The backend
# trusts X-Forwarded-For only from the nginx container, which compose gives
# this static address. Change both only if `docker compose up` reports
# "Pool overlaps with other one on this address space"; the IP must lie
# inside the subnet and must not be its first address (the gateway). After
# changing them run `docker compose down` once so the network is recreated.
# SWARMGUARD_SUBNET=172.28.0.0/24
# SWARMGUARD_PROXY_IP=172.28.0.10

# --- Attack simulator (simulate_attack.py, local demo only) --------------
# The simulator authenticates as a real operator and needs the same
# DRONE_API_KEY the backend is running with.
SWARMGUARD_API=http://localhost:8000
SWARMGUARD_USER=admin
SWARMGUARD_PASSWORD=
