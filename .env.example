# SwarmGuard AI — settings. Copy to .env before the first `docker compose up`.
# .env is gitignored. Never commit real values.
#
# SECRETS DO NOT GO IN THIS FILE when you run under Docker. They are files:
#
#   scripts/init-secrets.sh        # creates ./secrets/{secret_key,drone_api_key,
#                                  #   postgres_password,admin_password}
#
# As environment variables they were printed by `docker inspect` to anyone with
# Docker access. Compose passes them to the containers as *empty* variables, so
# even if you leave them below they cannot reach a container -- but the script
# does read them from here once, so an existing deployment keeps the database
# password its volume was initialised with.
#
# Running the backend natively (no Docker)? Then there is no /run/secrets, and
# the variables below are how it is configured. Generate each independently:
#   openssl rand -hex 32

# --- Database -----------------------------------------------------------
POSTGRES_USER=swarmguard
POSTGRES_DB=swarmguard
# Native runs only; under Docker this is ./secrets/postgres_password.
POSTGRES_PASSWORD=

# Native runs only. Inside Docker, compose builds the URL from POSTGRES_USER /
# POSTGRES_DB and the `postgres` hostname, and the password is joined in from
# its secret file (or from DATABASE_PASSWORD, for a URL that carries none).
# SQLite is not supported — the app requires PostgreSQL/TimescaleDB.
DATABASE_URL=postgresql://swarmguard:CHANGE_ME@localhost:5432/swarmguard

# --- Secrets (native runs only; 32+ chars, must be unique) ---------------
# Startup fails if these are missing, too short, or a known placeholder.
# Under Docker: ./secrets/secret_key and ./secrets/drone_api_key.
SECRET_KEY=
DRONE_API_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Cache / pub-sub ----------------------------------------------------
# Used when running the backend outside Docker. Inside Docker, compose
# overrides this with the `redis` service hostname.
REDIS_URL=redis://localhost:6379

# --- First-run provisioning (optional) ----------------------------------
# A username and a password create the default organization and its admin, once,
# from the migrate job. Password: at least 12 characters. Under Docker put it in
# ./secrets/admin_password (init-secrets.sh copies it from here the first time);
# only the migrate job can read that file, the API never sees it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- MAVLink ingest -----------------------------------------------------
# Disabled by default. With no MAVLink source configured the receiver would
# reconnect-loop against 127.0.0.1:14550 forever.
MAVLINK_ENABLED=false
# Required when MAVLINK_ENABLED=true. Telemetry ingested without an
# organization is written with organization_id NULL and is then invisible to
# every tenant.
MAVLINK_ORGANIZATION_ID=
MAVLINK_HOST=127.0.0.1
MAVLINK_PORT=14550
MAVLINK_PROTOCOL=udp

# --- Tier 1: kinematic guard ---------------------------------------------
# Deterministic physics checks. Limits describe the airframe's envelope with
# margin; defaults suit a fast multirotor. Raise for fixed-wing.
GUARD_ENABLED=true
GUARD_MAX_SPEED_MPS=60
GUARD_MAX_CLIMB_MPS=25
GUARD_GPS_SPEED_ERROR_MPS=25
GUARD_MIN_SATELLITES=6
# Rates are computed over the device's own sample clock (sample_time_ms,
# MAVLink time_boot_ms) when a packet carries one, and over server arrival
# time otherwise. This bounds how far the device clock may exceed arrival
# spacing before it is disbelieved for that pair.
GUARD_DEVICE_CLOCK_MAX_LEAD_S=10

# --- Tier 2: ML anomaly layer --------------------------------------------
# OFF because it is measured to not generalize: F1 0.086 with a 0.862 false
# positive rate under leave-one-flight-out validation. The authoritative
# numbers are backend/models_ml/v2/evaluation.json; see also the README.
AI_INCIDENTS_ENABLED=false

# --- Model ---------------------------------------------------------------
# Active version in backend/models_ml/. v2 is the RandomForest trained on real
# PX4 flights; v1 is the legacy IsolationForest trained on synthetic data.
# The feature list is read from the model's own metadata, so switching this
# does not require editing FEATURE_LIST.
MODEL_VERSION=v2

# --- Migrations ------------------------------------------------------------
# Under compose a one-shot `migrate` job applies migrations and the API waits
# for it; nothing to set. The API refuses to start against a schema that is
# behind the build. Turn the check off only while repairing a database by hand.
# REQUIRE_SCHEMA_AT_HEAD=true
#
# Running the image on its own, with no job to migrate first? Let it migrate
# before it serves. An advisory lock makes this safe even with several replicas,
# but each then pays for an alembic run on every start.
# RUN_MIGRATIONS_ON_START=false

# --- Where the secret files live (optional) --------------------------------
# Default ./secrets, which is gitignored. Point it outside the checkout -- a
# tmpfs, or wherever your secret manager's agent writes -- for anything real.
# SWARMGUARD_SECRETS_DIR=./secrets

# --- Compose network (optional) ------------------------------------------
# Everything in this file is passed to the backend container. The backend
# trusts X-Forwarded-For only from the nginx container, which compose gives
# this static address. Change both only if `docker compose up` reports
# "Pool overlaps with other one on this address space"; the IP must lie
# inside the subnet and must not be its first address (the gateway). After
# changing them run `docker compose down` once so the network is recreated.
# SWARMGUARD_SUBNET=172.28.0.0/24
# SWARMGUARD_PROXY_IP=172.28.0.10

# --- Attack simulator (simulate_attack.py, local demo only) --------------
# The simulator authenticates as a real operator and needs the same
# DRONE_API_KEY the backend is running with.
SWARMGUARD_API=http://localhost:8000
SWARMGUARD_USER=admin
SWARMGUARD_PASSWORD=
